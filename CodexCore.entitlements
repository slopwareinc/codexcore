<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- CodexCore intentionally does not enable App Sandbox: it launches the
         user-selected Codex runtime and arbitrary approved subprocesses. -->
    <!-- Dictation and realtime voice chat capture microphone audio. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Codex app-server, voice chat, and update checks make outbound requests. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- On-device dictation uses SFSpeechRecognizer after explicit consent. -->
    <key>com.apple.security.personal-information.speech-recognition</key>
    <true/>
</dict>
</plist>
